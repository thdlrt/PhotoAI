{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "照片选片",
  "mainBinaryName": "PhotoAI",
  "version": "0.9.0-beta.1",
  "identifier": "com.photoai.culler",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "category": "Photography",
    "copyright": "PhotoAI",
    "shortDescription": "本地 AI 照片选片与 Lightroom 工作流",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/core/": "core/",
      "resources/tools/": "tools/",
      "resources/integrations/": "integrations/",
      "resources/manifests/": "manifests/",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "startMenuFolder": "照片选片"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["photoai"]
      }
    }
  }
}
