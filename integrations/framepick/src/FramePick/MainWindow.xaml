<Window x:Class="FramePick.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:FramePick.Models"
 xmlns:controls="clr-namespace:FramePick.Controls"
 Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1440" Height="920" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
 KeyDown="Window_KeyDown" Closing="Window_Closing" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="18,24,18,20">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,-4,9,0"/><TextBlock Text="帧选" FontSize="23" FontWeight="Bold"/></StackPanel>
     <TextBlock Text="FRAMEPICK / 视频整理" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" IsEnabled="{Binding CanChangeProject}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource PrimaryButton}" Click="NewProject_Click" Content="新建项目" Padding="8" ToolTip="创建项目 (Ctrl+N)"/>
     <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="OpenProject_Click" Content="打开" Margin="6,0,0,0" Padding="8" ToolTip="打开项目 (Ctrl+O)"/>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,16,0,8">
     <Border Background="#11171E" CornerRadius="8" Padding="11" Margin="0,0,0,10">
      <StackPanel><TextBlock Text="当前项目" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding ProjectFilePath}"/>
      </StackPanel>
     </Border>
     <Button Style="{StaticResource PrimaryButton}" Click="Import_Click" Content="＋  导入文件夹" IsEnabled="{Binding CanImport}" ToolTip="每次导入一个文件夹 (Ctrl+I)"/>
     <ItemsControl ItemsSource="{Binding ImportedFolders}" MaxHeight="100" Margin="0,10,0,0">
      <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,3"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="素材库" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    </Grid>
    <StackPanel Grid.Row="4">
     <Border Background="#11171E" CornerRadius="8" Padding="13" Margin="0,12,0,14">
      <StackPanel><TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 个视频'}" FontWeight="SemiBold"/><TextBlock Text="{Binding UndecidedCount, StringFormat='{}{0} 项尚未分类'}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
     </Border>
     <Button Style="{StaticResource SecondaryButton}" Click="Categories_Click" Content="项目分类与设置" IsEnabled="{Binding CanManageCategories}"/>
     <Button Click="ImportLegacy_Click" Content="导入旧版分类与进度" FontSize="10" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasLegacySettings, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
   <Grid Margin="26,18,26,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding WorkspaceTitle}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectFilePath}"/>
     <TextBlock Text="{Binding FolderSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,20,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectFilePath}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0"><TextBlock Text="{Binding CountText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></Border>
     <Button Style="{StaticResource SecondaryButton}" Click="Retry_Click" Content="继续 / 重试预览" IsEnabled="{Binding CanGeneratePreviews}" ToolTip="生成未完成或失败的预览，保留已完成的预览"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="26,0,26,15">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
    <Grid>
     <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,12,8" ToolTip="按文件名搜索" AutomationProperties.Name="搜索视频"/>
     <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <TextBlock Text="搜索视频名称…" Foreground="{StaticResource MutedBrush}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
    <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" ToolTip="排序方式" AutomationProperties.Name="排序方式"/>
   </Grid>
   <Border Grid.Row="2" Background="#1A302B" CornerRadius="7" Margin="26,0,26,14" Padding="12,9" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding OperationText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="110" Margin="0,0,16,0"/>
     <ProgressBar Grid.Column="1" Value="{Binding OperationProgress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate}" VerticalAlignment="Center"/>
     <Button Grid.Column="2" Content="停止" Click="Cancel_Click" Margin="12,0,0,0" Padding="10,2" ToolTip="停止后保留已完成结果"/>
    </Grid>
   </Border>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="GalleryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,18,22" Focusable="False">
     <ItemsControl ItemsSource="{Binding VisibleVideos}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:MasonryPanel MinColumnWidth="288" Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:VideoItem}">
       <Border CornerRadius="11" BorderThickness="1" Padding="10">
        <Border.Style><Style TargetType="Border">
         <Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding HasCategory}" Value="True"><Setter Property="BorderBrush" Value="#598D7F"/></DataTrigger>
          <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/><Setter Property="Background" Value="#30232B"/></DataTrigger>
         </Style.Triggers>
        </Style></Border.Style>
        <StackPanel>
         <Button Padding="0" HorizontalContentAlignment="Stretch" Height="204" Background="#0D1116"
          Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="点击查看完整预览">
          <Grid ClipToBounds="True">
           <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers>
             <DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
             <DataTrigger Binding="{Binding IsPreviewLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
             <DataTrigger Binding="{Binding HasPreviewError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="等待生成预览" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
           </StackPanel>
           <Image Source="{Binding PreviewImage}" Stretch="Uniform">
            <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True"><Setter Property="Opacity" Value="0.35"/></DataTrigger></Style.Triggers></Style></Image.Style>
           </Image>
           <Border Background="#F0101820" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="正在生成 16 帧预览" FontSize="12" Foreground="{StaticResource AccentBrush}"/><ProgressBar IsIndeterminate="True" Width="110" Margin="0,13,0,0"/></StackPanel>
           </Border>
           <Border Background="#F0281D24" Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibility}}" Padding="18">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="预览失败" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap" MaxHeight="90" FontSize="11" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}" ToolTip="{Binding Error}"/></StackPanel>
           </Border>
           <Border Background="#DD101820" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"><TextBlock Text="{Binding DurationText}" FontSize="10"/></Border>
           <Border Background="#EF8F444D" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Visibility="{Binding IsMarkedForDeletion, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="待删除" FontSize="11" Foreground="White"/></Border>
          </Grid>
         </Button>
         <Button HorizontalContentAlignment="Left" Padding="0,11,0,3" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
          <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding FullPath}"/>
         </Button>
         <Grid Margin="0,3,0,12"><TextBlock Text="{Binding FileSizeText}" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding ExtensionText}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid>
         <Grid IsEnabled="{Binding DataContext.IsExecuting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Id"
           SelectedValue="{Binding CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择目标分类" AutomationProperties.Name="视频分类"/>
          <Button Grid.Column="1" Margin="7,0,0,0" Command="{Binding DataContext.ToggleDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE74D;"/><Setter Property="Background" Value="#28323D"/><Setter Property="ToolTip" Value="标记删除，执行后进入回收站"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True"><Setter Property="Content" Value="&#xE7A7;"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="Background" Value="#55303A"/><Setter Property="ToolTip" Value="取消删除标记"/></DataTrigger></Style.Triggers>
           </Style></Button.Style>
          </Button>
         </Grid>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
     <Border Width="76" Height="76" Background="#20372F" CornerRadius="20" HorizontalAlignment="Center"><Path Data="M 1,4 L 8,4 L 11,7 L 23,7 L 23,21 L 1,21 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Width="32" Height="27" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="{Binding EmptyTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,12"/>
     <TextBlock Text="{Binding EmptyDescription}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,0,0,22"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
      <Button Style="{StaticResource PrimaryButton}" Click="Import_Click" Content="选择视频文件夹" IsEnabled="{Binding CanImport}"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Button Style="{StaticResource PrimaryButton}" Click="NewProject_Click" Content="创建项目" IsEnabled="{Binding CanChangeProject}"/>
      <Button Style="{StaticResource SecondaryButton}" Click="OpenProject_Click" Content="打开已有项目" Margin="12,0,0,0" IsEnabled="{Binding CanChangeProject}"/>
     </StackPanel>
     <TextBlock Text="支持 MP4 · MOV · MKV · AVI 等 15 种格式" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
    </StackPanel>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}">
     <TextBlock Text="没有匹配的视频" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="试试其他分类，或清空搜索条件" Foreground="{StaticResource MutedBrush}" Margin="0,12" HorizontalAlignment="Center"/>
     <Button Content="重置筛选" Click="ResetFilter_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DecisionSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,18,0" Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVisibility}}">
      <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousPageCommand}" Click="Page_Click" ToolTip="上一页"/>
      <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextPageCommand}" Click="Page_Click" ToolTip="下一页"/>
     </StackPanel>
     <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Execute_Click" IsEnabled="{Binding CanExecute}" VerticalAlignment="Center"><TextBlock Text="{Binding ExecuteCount, StringFormat='执行整理 ({0})'}"/></Button>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.ColumnSpan="2" Background="#FC101318" Panel.ZIndex="20" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="114"/></Grid.RowDefinitions>
   <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <Button Content="←  返回" Style="{StaticResource SecondaryButton}" Command="{Binding CloseDetailCommand}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0"><TextBlock Text="{Binding SelectedVideo.FileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/><TextBlock Text="{Binding DetailPosition}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CloseDetailCommand}" ToolTip="关闭 (Esc)" HorizontalAlignment="Right"/>
   </Grid>
   <Grid Grid.Row="1" Margin="24,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousDetailCommand}" ToolTip="上一个 (←)" VerticalAlignment="Center"/>
    <Border Grid.Column="1" Background="#080C10" CornerRadius="10">
     <Grid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Margin="24">
       <TextBlock Text="预览尚未就绪" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedVideo.Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel>
      <Image Source="{Binding SelectedVideo.DetailImage}" Stretch="Uniform"/>
     </Grid>
    </Border>
    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextDetailCommand}" ToolTip="下一个 (→)" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
   <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Margin="0,16,0,0" Padding="28,15">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="{Binding SelectedVideo.FullPath}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedVideo.FullPath}"/><TextBlock Text="← → 连续浏览    Delete 标记 / 取消删除    Esc 返回" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="移动到分类" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedVideo.CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="详情分类"/></StackPanel>
     <Button Grid.Column="2" Margin="14,0,0,0" Style="{StaticResource DetailDeleteButton}" DataContext="{Binding SelectedVideo}" Command="{Binding DataContext.ToggleDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>

