<Window x:Class="FramePick.CategoryManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="clr-namespace:FramePick.Models"
 Style="{StaticResource {x:Type Window}}" Title="项目设置" Width="860" Height="700" MinWidth="740" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="68"/><RowDefinition Height="76"/><RowDefinition Height="46"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="32"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <TextBlock Text="项目设置" FontSize="23" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1"><TextBlock Text="项目名称" FontSize="12" Margin="0,0,0,7"/>
   <TextBox x:Name="ProjectNameInput" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="项目名称"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,12,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="预览帧数" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <ComboBox x:Name="PreviewFrameCountInput" Width="146" SelectedValuePath="Tag" SelectedValue="{Binding PreviewFrameCount, Mode=TwoWay}" AutomationProperties.Name="预览帧数">
     <ComboBoxItem Content="16 帧 · 4 × 4"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
     <ComboBoxItem Content="25 帧 · 5 × 5"><ComboBoxItem.Tag><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">25</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
    </ComboBox>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
    <TextBlock Text="预览并发数" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <ComboBox Width="65" SelectedItem="{Binding PreviewConcurrency, Mode=TwoWay}" AutomationProperties.Name="预览并发数">
     <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">1</sys:Int32><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">2</sys:Int32>
     <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">3</sys:Int32><sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Int32>
    </ComboBox>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="3"><TextBlock Text="分类与目标文件夹" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button x:Name="AddCategoryButton" Style="{StaticResource PrimaryButton}" Content="＋ 添加分类" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click"/>
  </Grid>
  <Grid Grid.Row="4" Margin="12,0,90,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="分类名称" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="移动到文件夹" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
  </Grid>
  <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="10">
   <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="CategoryList">
      <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:CategoryDefinition}">
       <Grid Margin="0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="分类名称" AutomationProperties.Name="分类名称" Margin="0,0,10,0" MaxLength="60"/>
        <TextBox Grid.Column="1" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Destination}" AutomationProperties.Name="目标文件夹" Margin="0,0,6,0"/>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="选择目标文件夹" AutomationProperties.Name="选择目标文件夹" Click="Browse_Click" Tag="{Binding}"><Path Data="M 1,4 L 8,4 L 11,7 L 23,7 L 23,21 L 1,21 Z" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Width="19" Height="16" Stretch="Uniform"/></Button>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}" ToolTip="移除此分类" Click="Remove_Click" Tag="{Binding}"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <TextBlock Text="还没有分类，点击右上角“添加分类”开始设置。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=CategoryList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Border>
  <TextBlock x:Name="ValidationMessage" Grid.Row="6" Foreground="{StaticResource DangerBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
  <Grid Grid.Row="7">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="82" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True"/>
    <Button x:Name="SaveCategoriesButton" Style="{StaticResource PrimaryButton}" Content="保存设置" MinWidth="100" Click="Save_Click" IsDefault="True"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
